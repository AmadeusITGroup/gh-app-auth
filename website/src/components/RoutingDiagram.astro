---
const rows = [
  { remote: 'github.com/acme/docs', pattern: 'github.com/acme', app: 'Org App' },
  { remote: 'github.com/acme/api', pattern: 'github.com/acme/api', app: 'API App', featured: true },
  { remote: 'github.com/tools/build', pattern: 'github.com/tools', app: 'Tools App' },
];
---

<figure class="routing" aria-labelledby="routing-title">
  <p id="routing-title" class="title">App-only URL matching, illustrated</p>
  <ol>
    {
      rows.map((row) => (
        <li class:list={{ featured: row.featured }}>
          <code>{row.remote}</code>
          <span class="arrow" aria-hidden="true">→</span>
          <span class="sr-only">matches pattern</span>
          <code class="pattern">{row.pattern}</code>
          <span class="sr-only">selects</span>
          <strong><span class="arrow" aria-hidden="true">↳ </span>{row.app}</strong>
        </li>
      ))
    }
  </ol>
  <figcaption>
    Simplified App-only URL matching: the longest matching pattern selects the GitHub App. This is not the full App
    and personal access token resolution, and not how patterns are passed to <code>--patterns</code>.
  </figcaption>
</figure>

<style>
  .routing {
    margin: 0;
    padding: 1rem 1.1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background: var(--sl-color-bg-nav);
  }
  .title {
    margin: 0 0 0.75rem;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.5rem;
    row-gap: 0.15rem;
    margin: 0;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background: var(--sl-color-bg);
  }
  li.featured {
    border-color: var(--sl-color-accent);
    box-shadow: 0 0 0 1px var(--sl-color-accent);
  }
  code {
    padding: 0;
    background: none;
    white-space: nowrap;
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--sl-color-white);
  }
  li.featured code {
    font-size: 0.85rem;
  }
  code.pattern {
    color: var(--sl-color-text-accent);
  }
  strong {
    flex-basis: 100%;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-white);
  }
  .arrow {
    color: var(--sl-color-gray-3);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  figcaption {
    margin-top: 0.85rem;
    font-size: var(--sl-text-xs);
    line-height: 1.55;
    color: var(--sl-color-gray-2);
  }
  figcaption code {
    font-size: inherit;
    white-space: normal;
  }
  @media (max-width: 40rem) {
    .routing {
      padding: 0.8rem;
    }
    code,
    li.featured code {
      font-size: 0.72rem;
    }
  }
</style>
