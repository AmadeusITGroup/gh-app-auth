---
interface Row {
  from: string;
  to: string;
  label: string;
  protocol?: string;
}

interface Props {
  title: string;
  rows: Row[];
  id: string;
}

const { title, rows, id } = Astro.props;
---

<figure class="relationships" aria-labelledby={`${id}-title`}>
  <p id={`${id}-title`} class="title">{title}</p>
  <ol>
    {
      rows.map((row) => (
        <li>
          <span class="node from">{row.from}</span>
          <span class="edge">
            <span class="sr-only">sends to</span>
            <span class="label">
              {row.label}
              {row.protocol && <span class="protocol"> ({row.protocol})</span>}
            </span>
            <span class="arrow" aria-hidden="true"></span>
            <span class="sr-only">{row.to}</span>
          </span>
          <span class="node to" aria-hidden="true">{row.to}</span>
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .relationships {
    margin: 2rem 0;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background: var(--sl-color-bg-nav);
  }
  .title {
    margin: 0 0 1rem;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  ol {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(9rem, 1.4fr) minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
    margin: 0;
  }
  .node {
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.5rem;
    background: var(--sl-color-bg);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1.4;
    color: var(--sl-color-white);
  }
  .edge {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: var(--sl-text-xs);
    line-height: 1.45;
    color: var(--sl-color-gray-2);
  }
  .protocol {
    color: var(--sl-color-gray-3);
  }
  .arrow {
    position: relative;
    width: 100%;
    height: 2px;
    background: var(--sl-color-gray-3);
  }
  .arrow::after {
    content: '';
    position: absolute;
    right: -1px;
    top: 50%;
    border: 6px solid transparent;
    border-left-color: var(--sl-color-gray-3);
    border-right: 0;
    transform: translateY(-50%);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (max-width: 50rem) {
    li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.4rem;
    }
    .edge {
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
      padding-inline-start: 0.5rem;
    }
    .label {
      order: 2;
    }
    .arrow {
      order: 1;
      width: 2px;
      height: 2.25rem;
      flex: none;
    }
    .arrow::after {
      right: auto;
      top: auto;
      bottom: -1px;
      left: 50%;
      border: 6px solid transparent;
      border-top-color: var(--sl-color-gray-3);
      border-bottom: 0;
      transform: translateX(-50%);
    }
  }
</style>
