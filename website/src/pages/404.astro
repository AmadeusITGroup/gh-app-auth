---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const base = import.meta.env.BASE_URL;
const links = [
  ['start-here/first-clone/', 'Your first authenticated clone'],
  ['guides/', 'Guides'],
  ['reference/cli/', 'CLI reference'],
  ['troubleshoot/', 'Troubleshooting'],
  ['understand/credential-routing/', 'How credential routing works'],
];
---

<StarlightPage frontmatter={{ title: 'Page not found', template: 'splash', pagefind: false }}>
  <p>
    The page you followed a link to is not part of this documentation, or it has moved.
  </p>
  <p>Start from one of these pages:</p>
  <ul>
    {links.map(([path, label]) => <li><a href={`${base}${path}`}>{label}</a></li>)}
  </ul>
</StarlightPage>
